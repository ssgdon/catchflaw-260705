ve"],"ChIJlcyw5pORQTURr26-RU7LBw4":["후쿠오카 플로럴 인 니시나카스","fukuoka-floral-inn-nishinakasu",1,1,"active"],"ChIJEQyMkjGSQTURcKQ6aix5-LM":["헤이와다이 호텔 아라토","heiwadai-hotel-arato",1,1,"active"],"ChIJtRQKxJqRQTUR0dPMYPLotcQ":["니시테츠 인 텐진","nishitetsu-inn-tenjin",1,1,"active"],"ChIJQcE_CqmRQTURM5J1jZL77bM":["호텔 라 포레스타 by 리그나","hotel-la-foresta",1,1,"active"],"ChIJmevWGu2RQTURHCX71AT7o3A":["더 그랜드 레지던스 호텔 텐진","the-grand-residence-hotel-tenjin",1,1,"active"],"ChIJwwuJcbmRQTURoXSe0JmZowc":["아파호텔 하카타 에키마에","apa-hotel-hakata-ekimae",1,1,"active"]},"deploys":[{"commit":"a4b90d3d","date":"2026-11-14T09:25:34+09:00","subject":"fix(analytics): 비교 화면 호텔 추가 기록의 'source' 값이 GA 세션 출처를 덮어쓰던 문제"},{"commit":"99dbfb0b","date":"2026-11-12T23:58:12+09:00","subject":"build: 블로그 카드 정리(다른 호텔 후기 제거·제목 기호) 재빌드 + 배포 기록(changes.json 312cd350)"},{"commit":"312cd350","date":"2026-11-12T23:56:04+09:00","subject":"fix(detail): 네이버 블로그 카드 제목의 &lt; 등 기호 코드가 그대로 보이던 문제"},{"commit":"8f74afe7","date":"2026-11-12T23:22:06+09:00","subject":"build: 리뷰 카드 '분류 오류 신고' 문구·깃발 재빌드 + 배포 기록(changes.json 967bb675)"},{"commit":"967bb675","date":"2026-11-12T23:19:37+09:00","subject":"fix(detail): 리뷰 카드 '분류가 이상해요' → 깃발 아이콘 + '분류 오류 신고'"}],"changes":[{"date":"2026-11-14","commit":"a4b90d3d","title":"비교 화면 호텔 추가가 GA 방문 출처를 덮어쓰던 측정 오류 수정","what":"compare_add 이벤트의 source 매개변수를 from으로 바꿨다. GA가 이 값을 방문 출처로 읽어 호텔을 추가한 방문이 'compare_page' 유입으로 잡혔다(10-09부터 41세션). 이후 유입 채널 숫자에서 compare_page가 사라지고 네이버·직접이 그만큼 늘어야 한다. 화면 변화는 없다","watch":[],"doc":""},{"date":"2026-11-12","commit":"312cd350","title":"네이버 블로그 카드에서 다른 호텔 후기 제거 + 제목 기호 깨짐 수정","what":"블로그 카드는 제목에 그 호텔 이름이 있는 글만 남기고, 다른 호텔·다른 지점·콘서트 후기를 뺐다(VM fetch_social.py 규칙, 카드 1,673→1,593장). 제목의 &lt; 등 기호 코드가 그대로 보이던 19장을 고쳤다. 상세 블로그 열람 비율이 떨어지지 않는지 본다","watch":[],"doc":"pipeline/fetch_social.py"},{"date":"2026-11-12","commit":"967bb675","title":"리뷰 카드 '분류가 이상해요' → 깃발 + '분류 오류 신고'","what":"리뷰 팝업·상세 인용 카드의 신고 버튼 문구가 안내문처럼 읽혀 그 리뷰의 분류가 틀렸다는 표시로 오해할 수 있었다. 깃발 아이콘과 행동 문구로 바꾸고 신고 뒤 표시는 '신고 완료'로","watch":[],"doc":"UI-STANDARDS.md"},{"date":"2026-11-11","commit":"15aa7176","title":"Meta 픽셀 이벤트를 광고 계정용 데이터 세트(Nitpicker)로도 전송","what":"광고 계정에 CatchFlaw 픽셀을 연결할 수 없어, 그 계정에서 고를 수 있는 Nitpicker 픽셀을 두 번째로 넣었다. 같은 이벤트 4개를 두 곳에 보낸다. 화면·속도 지표에는 변화가 없어야 한다","watch":[],"doc":"marketing/ig-ad/PLAN.md"},{"date":"2026-11-11","commit":"6d9e2e0c","title":"Meta 픽셀 추가(방문·상세 조회·검색·가격 버튼)","what":"전 페이지에 Meta 픽셀을 GA·Clarity와 같은 때 싣는다. 보내는 이벤트는 PageView·ViewContent(상세)·Search·InitiateCheckout(가격 버튼 = check_price_click) 4개뿐이고 자동 수집은 껐다. 운영자 기기는 전송 없음. 개인정보 처리방침에 Meta 픽셀을 추가하고 시행일을 11-11로 고침. 화면·속도 지표에는 변화가 없어야 한다","watch":[],"doc":"marketing/ig-ad/PLAN.md"},{"date":"2026-11-11","commit":"9fb34843","title":"관리자 지표에서 광고 유입 제외","what":"VM 집계가 세션 매체가 유료인 세션을 GA 조회 전부(세션·착지·채널·깔때기·호텔별·일별·변경 전후)에서 뺀다. 화면에는 뺀 건수만 적는다. 광고 집행 여부가 배포 전후 판정을 흔들지 않게 하려는 것이라 지표 자체는 그대로다","watch":[],"doc":"marketing/ig-ad/PLAN.md"},{"date":"2026-11-10","commit":"06cef7b2","title":"광고·소셜 클릭 유입은 GA·Clarity 즉시 로드","what":"주소에 utm_medium=paid·cpc, fbclid, gclid가 있으면 load+1.5초를 기다리지 않고 바로 측정 스크립트를 싣는다(1~2초 보고 나가는 광고 방문도 세션으로 남김). 일반·검색 유입은 그대로라 자연 유입 지표는 안 변함. 광고 집행 뒤 측정은 marketing/ig-ad/ad_report.py","watch":[],"doc":"marketing/ig-ad/PLAN.md"},{"date":"2026-11-10","commit":"67ec1703","title":"아고다 제휴 링크 93곳 추가(101→194) — 채점 상세 전부 아고다","what":"링크 없던 93곳(라이프 텐진·서튼·베이직스·포르자 II·마이스테이 텐진 등)의 가격 버튼이 구글 → 아고다. 같은 호텔 중복 등록은 리뷰 많은 옛 등록으로","watch":["cta_rate","cta_agoda_share"],"doc":"affiliate"},{"date":"2026-11-09","commit":"48e66499","title":"검색 결과 제목·요약문·썸네일 다시 쓰기 (SEO-GOOGLE §8)","what":"제목 '아이랑 가도 될까? 확인할 3가지'/'예약 전 확인할 3가지: a·b·c', 썸네일 = 객실 사진 + 노랑 주의 배지 + '벌레 0건'(카톡 미리보기 그림도 같이 바뀜), 범례 문장을 검색 요약문에서 빼기. 검색 CTR은 구글 검색 탭·네이버 서치어드바이저에서 4주 뒤 비교","watch":["share"],"doc":"SEO-GOOGLE-DESIGN.md"},{"date":"2026-11-09","commit":"00e16023","title":"아고다 제휴 링크 7곳 추가(94→101) · 주간 데이터(11-08 기준) · 리브맥스 하카타 에키마에 편입","what":"몬토레 후쿠오카·프린스 스마트 인·칸데오 텐진·리솔 트리니티·WBF 그란데·JR 규슈 블라섬 주오·비아인 하카타구치의 가격 버튼이 구글 → 아고다","watch":["cta_rate","cta_agoda_share"],"doc":"affiliate"},{"date":"2026-11-07","commit":"b0496823","title":"조건 검색어 → 필터 · 미지원 도시 오타 · 옛 /hotel/* 301 · 관리자 인사이트 보정","what":"'방음 좋은 숙소' 같은 조건 검색어를 불만 적은 항목·한 번도 없어야·지역·정렬로, 벳퓨 같은 도시 오타도 미지원 안내, 옛 /hotel/{uuid} → /hotels, 관리자는 이어 본 세션 분리·검색은 마지막 변경 뒤부터","watch":["search_noresult_rate"],"doc":"admin 인사이트 2026-11-07"},{"date":"2026-11-06","commit":"7258710a","title":"카톡 공유 미리보기 카드(사진 + 실망 확률) · '같이 갈 사람에게 보내기' 버튼","what":"og:image = 호텔별 1200×630 카드(사진·실망 확률·판정·평균), og:title '호텔 · 실망 확률 N%', 누구와 가세요 끝 공유 버튼, 공유 주소 utm_source=share","watch":["share"],"doc":""},{"date":"2026-11-05","commit":"00000cb7","title":"관리자 '구글 검색' 탭(서치 콘솔) · Organization sameAs 인스타·스레드","what":"관리자 전용: 검색 실적·검색어·사이트맵 전수 URL 검사 색인 상태·오늘 색인 요청할 곳. 사이트는 JSON-LD sameAs 2줄만 — 사용자 화면 지표 없음","watch":[],"doc":"SEO-GOOGLE-DESIGN.md"},{"date":"2026-11-05","commit":"6b176897","title":"상세 CTA 문구 '내 일정 최저가 보기' (CTR)","what":"아고다 최저가 보기 → 아고다에서 내 일정 최저가 보기(모바일 가격 옆은 내 일정 최저가 보기), 구글은 구글에서 내 일정 가격 보기","watch":["cta_rate","cta_agoda_share"],"doc":"UX-DROPOFF-2611-DESIGN.md"},{"date":"2026-11-05","commit":"846d72fb","title":"비교 화면 크롤 차단 · 리뷰 시트 링크 #rv= (SEO-GOOGLE 후속)","what":"robots.txt Disallow /compare, 비교 화면 → 상세 리뷰 시트 링크를 ?rv= 에서 #rv= 로(옛 링크도 열림) — 구글이 noindex·중복 주소를 긁지 않게","watch":["next_row_clicks"],"doc":"SEO-GOOGLE-DESIGN.md"},{"date":"2026-11-05","commit":"bedea222","title":"상세 섹션 재배치 · 위치→실전정보 · 리뷰 수치 접힘 · 마법사 · 홈 칩 (UX-2611 C·D)","what":"실망 확률 3,030→1,660px, 위치→실전정보, 리뷰 수치 접힘, 마법사 못 참는 것 먼저, 홈 많이 찾는 호텔 칩","watch":["scroll90_rate","tab_rate","numfold_clicks","rec_submit","home_pop_clicks"],"doc":"UX-DROPOFF-2611-DESIGN.md"},{"date":"2026-11-05","commit":"30566668","title":"아고다 제휴 링크 94곳 CTA · 피드백 시트 분리 (UX-2611 B)","what":"제휴 링크 있는 상세는 '아고다 최저가 보기'(rel=sponsored), 피드백 시트는 CTA를 막지 않고 돌아왔을 때 토스트·상세 끝 '의견 남기기'","watch":["cta_rate","cta_agoda_share","fb_toast","fb_submit"],"doc":"UX-DROPOFF-2611-DESIGN.md"},{"date":"2026-11-05","commit":"53a3653c","title":"피드백 '보내고 이동' 동기 열기 · 실망 확률 칸 링크 · 공유 측정 (UX-2611 A)","what":"피드백 시트 새 탭을 클릭 안에서 열기(모바일 팝업 차단 회피), 요약 실망 확률 칸 → #sec-prob, 공유 버튼 GA share","watch":["fb_submit","sum_prob_clicks","share"],"doc":"UX-DROPOFF-2611-DESIGN.md"},{"date":"2026-11-04","commit":"c59fda6a","title":"검색 개편 SEARCH-2611 — 소리 키 퍼지 매칭 · 구글 지도 링크 · 구글 장소 폴백 (기록은 11-07에 보충)","what":"표기 조합 사전 대신 소리 키로 이름 비교(리졸↔리솔·치구시↔치쿠시), 지도 링크(짧은 링크 포함)를 호텔로, 못 찾으면 구글 장소 검색으로 미등록 호텔 안내","watch":["search_noresult_rate"],"doc":"SEARCH-2611"},{"date":"2026-11-04","commit":"4c0c0c59","title":"한눈에 보기 → 리뷰 시트 · 결론 뒤 비교 3행 · 홈 CTA 인라인 · 종료 확인 측정 (UX-2611 A)","what":"한눈에 보기 항목을 누르면 그 항목 리뷰 시트, 결론 바로 뒤 '비교해 볼 만한 호텔' 3행, 홈 추천 버튼 인라인, exit_shown·exit_stay·exit_leave","watch":["glance_item","next_row_clicks","hero_rec_clicks","exit_stay_rate"],"doc":"UX-DROPOFF-2611-DESIGN.md"}],"pending":[{"title":"종료 확인 다이얼로그 제거 여부","from":"UX-DROPOFF-2611-DESIGN.md","why":"뒤로 가기 때 뜨는 확인 창이 머무는 효과가 없으면 방해만 된다","needs":"11-18 이후 exit_stay / exit_shown 비율 확인 뒤 사용자 결정"},{"title":"허브 H1 '리뷰 위험도' 용어","from":"SEO-GOOGLE-DESIGN.md","why":"화면 용어는 '실망 확률' 하나인데 허브 제목에 '위험도'가 남아 있다","needs":"서치어드바이저 검색어에서 '위험도'로 들어오는 비중 확인"},{"title":"제휴 링크 없는 조회 상위 · 라쿠텐 스테이 하카타역북","from":"ADMIN-DESIGN §6","why":"마이스테이스 텐진 미나미는 조회가 많은데 가격 버튼이 구글로 나간다. 라쿠텐 스테이 하카타역북(클릭 3)은 11-09에 받은 링크 883074가 야쿠인 지점으로 가서 넣지 않았다","needs":"세시간전 대시보드에서 두 호텔 링크를 만들어 scripts/affiliate.json에 추가"}]}